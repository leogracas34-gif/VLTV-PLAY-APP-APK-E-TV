<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070710">

    <!-- ═══════════════════════════════════════
         HEADER FLUTUANTE
         ✅ MediaRouteButton (ícone de cast) REMOVIDO — era ele quem
         disparava a inicialização do Cast Framework e fazia o ícone de
         compartilhamento de tela aparecer fixo no status bar do Android.
    ═══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header_gradient"
        android:elevation="20dp"
        android:translationZ="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:src="@drawable/ic_launcher"
            android:scaleType="fitCenter"
            android:contentDescription="Logo"
            android:visibility="gone"/>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

    </LinearLayout>

    <!-- ═══════════════════════════════════════
         SCROLL PRINCIPAL
    ═══════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="68dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- BANNER HERO -->
            <!-- ALTERAÇÃO: 520dp → 460dp. Reduz a área total do banner,
                 o que "levanta" tudo que vem abaixo (botões, banners,
                 fileiras) sem precisar mexer em margens negativas.
                 Obs: a faixa escura que aparece no topo de algumas imagens
                 (ex.: backdrops do TMDB com vinheta pra dar contraste ao
                 texto) é parte da própria imagem de origem — reduzir a
                 altura do banner diminui a proporção dessa área vazia,
                 mas não remove 100% quando a imagem já vem assim de fábrica. -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/bannerViewPager"
                android:layout_width="match_parent"
                android:layout_height="460dp"
                android:clipToPadding="false"
                android:clipChildren="false"/>

            <!-- BOTÕES DE CATEGORIA -->
            <LinearLayout
                android:id="@+id/mainButtonsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp"
                android:weightSum="4">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardLiveTv"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="5dp"
                    app:cardBackgroundColor="#00000000">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_card_live">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📡" android:textSize="17sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AO VIVO" android:textColor="#FFFFFF" android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.1" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardMovies"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="5dp"
                    app:cardBackgroundColor="#00000000">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_card_movies">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎬" android:textSize="17sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FILMES" android:textColor="#FFFFFF" android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.1" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSeries"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="5dp"
                    app:cardBackgroundColor="#00000000">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_card_series">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎭" android:textSize="17sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SÉRIES" android:textColor="#FFFFFF" android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.1" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ─────────────────────────────────
                     CARD DOWNLOADS (substitui o antigo card Kids)
                     O Kids agora tem perfil próprio, selecionado direto na
                     tela de perfis — esse atalho aqui dentro do perfil
                     adulto ficou redundante. No lugar, abre a tela de
                     Downloads (DownloadsActivity), que ainda não tinha
                     nenhum botão de acesso em lugar nenhum do app.
                ───────────────────────────────── -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardDownloads"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="5dp"
                    app:cardBackgroundColor="#00000000">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_card_downloads">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_download_box_premium"
                            android:contentDescription="Downloads"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DOWNLOADS" android:textColor="#FFFFFF" android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.1" android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ─────────────────────────────────
                 BANNER "DESTAQUE DA SEMANA" (Firebase Remote Config)
                 Filme ou série em destaque, com sinopse e botões
                 Assistir / Detalhes que levam pra tela correta.
                 Visibilidade e conteúdo controlados 100% pelo Kotlin
                 (aplicarFeaturedBanner). Se "show_featured_banner" = false,
                 o card fica GONE e o que vem abaixo sobe automaticamente.
            ───────────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFeaturedBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#0D0D1A">

                <!-- Imagem de fundo (poster/backdrop enviado no Firebase) -->
                <ImageView
                    android:id="@+id/imgFeaturedBanner"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:scaleType="centerCrop"
                    android:alpha="0.55"/>

                <!-- Overlay escuro pra garantir contraste do texto -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:background="#B3070710"/>

                <!-- Conteúdo sobre a imagem -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:orientation="vertical"
                    android:gravity="bottom"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <!-- Badge "DESTAQUE DA SEMANA" -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥  DESTAQUE DA SEMANA"
                        android:textColor="#FFD700"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:background="#33FFD700"
                        android:layout_marginBottom="8dp"/>

                    <!-- Título do filme/série -->
                    <TextView
                        android:id="@+id/tvFeaturedTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nome do Filme"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end"/>

                    <!-- Sinopse curta -->
                    <TextView
                        android:id="@+id/tvFeaturedSynopsis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sinopse do filme ou série aparece aqui, resumida em poucas linhas."
                        android:textColor="#CCCCCC"
                        android:textSize="11.5sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_marginTop="4dp"/>

                    <!-- Botões Assistir / Detalhes -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnFeaturedAssistir"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="6dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFFFFF">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="▶  ASSISTIR"
                                android:textColor="#070710"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp"/>
                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnFeaturedDetalhes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardCornerRadius="6dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#33FFFFFF">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ⓘ  DETALHES"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp"/>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ─────────────────────────────────
                 CARD "JOGOS RETRÔ" — botão premium, logo abaixo
                 do Destaque da Semana. Gradiente neon roxo→magenta
                 (bg_card_retro_games), badge "NOVO", ícone de controle e
                 seta indicando toque. Leva direto pra RetroGamesActivity.
                 ✅ ATUALIZADO: agora começa GONE, igual aos outros dois
                 banners controlados por Firebase (cardFeaturedBanner /
                 cardGameBanner) logo acima e abaixo — quem decide se ele
                 aparece é aplicarRetroGamesCard() no Kotlin, lendo o
                 parâmetro "show_retro_games" do Remote Config. Pra
                 ativar/desativar essa aba, basta mudar esse valor no
                 console do Firebase, sem precisar mexer em código nem na
                 VPS.
            ───────────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRetroGames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="10dp"
                app:cardBackgroundColor="#00000000">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="86dp"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_card_retro_games">

                    <!-- Ícone de controle, em destaque -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕹️"
                        android:textSize="30sp"
                        android:layout_marginEnd="14dp"/>

                    <!-- Título + subtítulo -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="JOGOS RETRÔ"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.02"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="NOVO"
                                android:textColor="#FFFFFF"
                                android:textSize="8sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:background="@drawable/bg_badge_novo"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="3dp"
                                android:paddingBottom="3dp"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Clássicos de vídeo game direto no app, sem baixar nada"
                            android:textColor="#E8E0FF"
                            android:textSize="11.5sp"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:layout_marginTop="3dp"/>

                    </LinearLayout>

                    <!-- Seta indicando toque -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ─────────────────────────────────
                 BANNER JOGO AO VIVO (Firebase Remote Config)
                 Visibilidade controlada pelo Kotlin
                 Aparece entre os botões e o "Continuar Assistindo"
            ───────────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGameBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#0D0D1A">

                <!-- Imagem de fundo do jogo -->
                <ImageView
                    android:id="@+id/imgGameBanner"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:scaleType="centerCrop"
                    android:alpha="0.45"/>

                <!-- Overlay escuro gradiente sobre a imagem -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:background="#99070710"/>

                <!-- Conteúdo sobre a imagem -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:gravity="center_vertical">

                    <!-- Lado esquerdo: badge + título + data/hora -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Badge AO VIVO ou EM BREVE -->
                        <TextView
                            android:id="@+id/tvGameBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚽  EM BREVE"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.12"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:background="#CC1B5E20"
                            android:layout_marginBottom="6dp"/>

                        <!-- Ex: Brasil x Escócia -->
                        <TextView
                            android:id="@+id/tvGameTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Brasil x Escócia"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:ellipsize="end"/>

                        <!-- Ex: 18 de Junho  •  16h00 (Brasília) -->
                        <TextView
                            android:id="@+id/tvGameDatetime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18 de Junho  •  16h00 (Brasília)"
                            android:textColor="#BBBBBB"
                            android:textSize="11sp"
                            android:layout_marginTop="3dp"/>

                        <!-- Ex: 📺 Globo / SporTV -->
                        <TextView
                            android:id="@+id/tvGameChannel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📺  Globo / SporTV"
                            android:textColor="#FFD700"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"/>

                    </LinearLayout>

                    <!-- Lado direito: ícone de seta (toque p/ assistir) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▶"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:alpha="0.7"
                        android:layout_marginStart="12dp"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- CONTINUAR ASSISTINDO -->
            <LinearLayout
                android:id="@+id/layoutContinueHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="24dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <View
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="#E50914"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/tvContinueWatching"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Continuar Assistindo"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01"/>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvContinueWatching"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:overScrollMode="never"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                android:visibility="gone"/>

            <!-- TOP 10 FILMES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="24dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical">
                <View
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="#E50914"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top 10 Filmes Hoje"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.01"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTop10Movies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:overScrollMode="never"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            <!-- FILMES PARA VOCÊ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="28dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical">
                <View
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="#1F80E0"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filmes Para Você"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentlyAdded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:overScrollMode="never"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            <!-- TOP 10 SÉRIES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="28dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical">
                <View
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="#E50914"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top 10 Séries Hoje"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTop10Series"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:overScrollMode="never"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            <!-- SÉRIES PARA VOCÊ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="28dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical">
                <View
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="#7B2FBE"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Séries Para Você"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentSeries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:overScrollMode="never"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

            <!-- NOVIDADES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="28dp"
                android:paddingBottom="10dp"
                android:gravity="center_vertical">
                <View
                    android:layout_width="3dp"
                    android:layout_height="16dp"
                    android:background="#00C853"
                    android:layout_marginEnd="10dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Novidades"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNovidades"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="20dp"
                android:overScrollMode="never"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav"
        app:itemIconTint="@drawable/bottom_nav_tint"
        app:itemTextColor="@drawable/bottom_nav_tint"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
